pipeline {
    agent any
    
    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '<your-account-id>.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'devops1910-flask'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        CLUSTER_NAME = 'DevOps1910-cluster'
        APP_NAME     = 'devops1910-flask'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Unit Tests') {
            steps {
                sh '''
                    pip install -r requirements.txt
                    python -m pytest tests/ -v
                '''
            }
        }
        
        stage('Code Scan - SonarQube') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'sonar-scanner'
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} \
                        -t ${ECR_REGISTRY}/${ECR_REPO}:latest \
                        .
                '''
            }
        }
        
        stage('Image Scan - Trivy') {
            steps {
                sh '''
                    trivy image \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }
        
        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password \
                        --region $AWS_REGION | \
                    docker login \
                        --username AWS \
                        --password-stdin $ECR_REGISTRY
                    
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                    docker push ${ECR_REGISTRY}/${ECR_REPO}:latest
                '''
            }
        }
        
        stage('Deploy to DEV') {
            steps {
                sh '''
                    aws eks update-kubeconfig \
                        --name $CLUSTER_NAME \
                        --region $AWS_REGION
                    
                    helm upgrade --install \
                        --atomic \
                        --namespace dev \
                        --create-namespace \
                        $APP_NAME ./helm-chart \
                        --set image.repository=${ECR_REGISTRY}/${ECR_REPO} \
                        --set image.tag=${IMAGE_TAG}
                '''
            }
        }
        
        stage('Integration Tests') {
            steps {
                sh '''
                    python -m pytest tests/integration/ -v
                '''
            }
        }
        
        stage('Deploy to STAGING') {
            steps {
                sh '''
                    helm upgrade --install \
                        --atomic \
                        --namespace staging \
                        --create-namespace \
                        $APP_NAME ./helm-chart \
                        --set image.repository=${ECR_REGISTRY}/${ECR_REPO} \
                        --set image.tag=${IMAGE_TAG}
                '''
            }
        }
        
        stage('Manual Approval') {
            steps {
                input message: 'Deploy to Production?', ok: 'Deploy'
            }
        }
        
        stage('Deploy to PROD') {
            steps {
                sh '''
                    helm upgrade --install \
                        --atomic \
                        --namespace prod \
                        --create-namespace \
                        $APP_NAME ./helm-chart \
                        --set image.repository=${ECR_REGISTRY}/${ECR_REPO} \
                        --set image.tag=${IMAGE_TAG} \
                        --set replicaCount=3
                '''
            }
        }
    }
    
    post {
        success {
            echo ' Pipeline succeeded!'
        }
        failure {
            echo ' Pipeline failed - check logs!'
        }
        always {
            sh """
                docker rmi ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} || true
                docker rmi ${ECR_REGISTRY}/${ECR_REPO}:latest || true
            """
        }
    }
}
